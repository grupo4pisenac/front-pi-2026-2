# true = usa mocks tipados em src/services/mocks; false = chama o backend FastAPI (barto-io-api)
VITE_USE_MOCKS=false
# Base da API REST (em dev o Vite faz proxy de /api para VITE_API_PROXY_TARGET)
VITE_API_BASE_URL=/api
# Endereço do backend usado pelo proxy do Vite
VITE_API_PROXY_TARGET=http://localhost:8000
